#: ../../../tutorials/04-matrix-multiplication.md:140
msgid ""
"for i in 0i32..(K / BK) {\n"
"    let tile_x = part_x.load([pid_m, i]);  // Load A[row_group, i]\n"
"    let tile_y = part_y.load([i, pid_n]);  // Load B[i, col_group]\n"
"    tile_z = mma(tile_x, tile_y, tile_z);  // Accumulate: C += A @ B\n"
"}\n"
msgstr ""

