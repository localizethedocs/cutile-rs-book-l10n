"K: i32>(\n"
"    z: &mut Tensor<E, { [BM, BN] }>,   // BM, BN inferred from z's "
"partition_shape\n"
"    x: &Tensor<E, { [-1, K] }>,        // K inferred from x's shape[1]\n"
"    y: &Tensor<E, { [K, -1] }>,        // K also available from y's "
"shape[0]\n"
