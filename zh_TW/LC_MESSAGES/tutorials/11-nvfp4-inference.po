#: ../../../tutorials/11-nvfp4-inference.md:142
msgid "Converting Host Bytes"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:144
msgid "The code below creates typed device tensors from plain byte vectors."
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:146
msgid ""
"use cutile::api::{self, DeviceOpReshape};\n"
"use cutile::cuda_core::{f4e2m1fnx2, f8e4m3fn};\n"
"use std::sync::Arc;\n"
"\n"
"fn packed_fp4(bytes: Vec<u8>) -> Arc<Vec<f4e2m1fnx2>> {\n"
"    Arc::new(bytes.into_iter().map(f4e2m1fnx2::from_bits).collect())\n"
"}\n"
"\n"
"fn fp8_e4m3(bytes: Vec<u8>) -> Arc<Vec<f8e4m3fn>> {\n"
"    Arc::new(bytes.into_iter().map(f8e4m3fn).collect())\n"
"}\n"
"\n"
"let m = 128usize;\n"
"let n = 256usize;\n"
"let k = 512usize;\n"
"\n"
"// Self-contained example data. In a real model, these bytes come from the\n"
"// model-loading path after it has arranged data in the layout above.\n"
"let activation_bytes = vec![0x22u8; m * k / 2];\n"
"let weight_bytes = vec![0x22u8; n * k / 2];\n"
"let activation_scale_bytes = vec![0x38u8; m * k / 16];\n"
"let weight_scale_bytes = vec![0x38u8; n * k / 16];\n"
"\n"
"let x = api::copy_host_vec_to_device(&packed_fp4(activation_bytes))\n"
"    .reshape(&[m, k / 2]);\n"
"let y = api::copy_host_vec_to_device(&packed_fp4(weight_bytes))\n"
"    .reshape(&[n, k / 2]);\n"
"let x_scales = api::"
"copy_host_vec_to_device(&fp8_e4m3(activation_scale_bytes))\n"
"    .reshape(&[m, k / 16]);\n"
"let y_scales = api::copy_host_vec_to_device(&fp8_e4m3(weight_scale_bytes))\n"
"    .reshape(&[n, k / 16]);\n"
"\n"
"let alpha = 1.0f32;\n"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:182
msgid "Convert each byte to packed FP4 storage:"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:184
msgid "u8 -> f4e2m1fnx2::from_bits(byte)\n"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:188
msgid ""
"The conversion changes the type without changing the memory layout. To pack "
"FP4 values yourself, use `f4e2m1fnx2::from_nibbles(low, high)`."
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:191
msgid "Tensor<u8> Escape Hatch"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:191
msgid "<u8>"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:193
msgid ""
"Prefer `Tensor<f4e2m1fnx2, ...>` for packed FP4 inputs because the kernel "
"signature then documents the data contract. If an interop boundary already "
"owns a `Tensor<u8>` and changing its type is inconvenient, cuTile still "
"supports the low-level path: load the bytes as `u8` and use generic `unpack` "
"to produce logical FP4 values."
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:199
msgid ""
"#[cutile::entry()]\n"
"fn unpack_packed_fp4_bytes(\n"
"    output: &mut Tensor<f4e2m1fnx2, { [32] }>,\n"
"    input: &Tensor<u8, { [-1] }>,\n"
") {\n"
"    let bytes = load_tile(input, shape![32], [0]);\n"
"    let f4s: Tile<f4e2m1fn, { [64] }> = unpack(bytes);\n"
"    let packed = f4s.pack(shape![32]);\n"
"    output.store(packed);\n"
"}\n"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:212
msgid ""
"Every `u8` bit pattern is valid byte storage, so this unpacking is safe."
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:216
msgid "Kernel Pattern"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:218
msgid ""
"The kernel loads packed bytes, unpacks them to logical FP4 matrix tiles, "
"then calls `mmaf_scaled`:"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:221
msgid ""
"#[cutile::module]\n"
"mod nvfp4_linear {\n"
"    use cutile::core::*;\n"
"\n"
"    #[cutile::entry()]\n"
"    fn linear_tile<\n"
"        const BM: i32,\n"
"        const BN: i32,\n"
"        const BK: i32,\n"
"        const BK_PACKED: i32,\n"
"        const BK_SCALES: i32,\n"
"    >(\n"
"        z: &mut Tensor<f32, { [BM, BN] }>,\n"
"        x: &Tensor<f4e2m1fnx2, { [-1, -1] }>,\n"
"        y: &Tensor<f4e2m1fnx2, { [-1, -1] }>,\n"
"        x_scales: &Tensor<f8e4m3fn, { [-1, -1] }>,\n"
"        y_scales: &Tensor<f8e4m3fn, { [-1, -1] }>,\n"
"        alpha: f32,\n"
"    ) {\n"
"        let pid_m = program_id(0);\n"
"        let pid_n = program_id(1);\n"
"\n"
"        let part_x = x.partition(shape![BM, BK_PACKED]);\n"
"        let part_y = y.partition(shape![BN, BK_PACKED]);\n"
"        let part_x_scales = x_scales.partition(shape![BM, BK_SCALES]);\n"
"        let part_y_scales = y_scales.partition(shape![BN, BK_SCALES]);\n"
"\n"
"        let mut tile_z = constant(0.0f32, shape![BM, BN]);\n"
"\n"
"        for k_tile in 0i32..num_tiles(&part_x, 1) {\n"
"            let tile_x_packed = part_x.load([pid_m, k_tile]);\n"
"            let tile_y_packed = part_y.load([pid_n, k_tile]);\n"
"\n"
"            let tile_x = tile_x_packed.unpack(shape![BM, BK]);\n"
"            let tile_y = tile_y_packed.unpack(shape![BN, BK]).transpose();\n"
"\n"
"            let tile_x_scales = part_x_scales.load([pid_m, k_tile]);\n"
"            let tile_y_scales = part_y_scales.load([pid_n, k_tile])."
"transpose();\n"
"\n"
"            tile_z = mmaf_scaled(tile_x, tile_y, tile_z, tile_x_scales, "
"tile_y_scales);\n"
"        }\n"
"\n"
"        let alpha_tile = broadcast_scalar(alpha, z.shape());\n"
"        z.store(tile_z * alpha_tile);\n"
"    }\n"
"}\n"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:270
msgid "Unpacking doubles the number of elements:"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:272
msgid ""
"Tile<f4e2m1fnx2, [BM, BK_PACKED]>  // BK_PACKED = BK / 2\n"
"    unpack(shape![BM, BK]) -> Tile<f4e2m1fn, [BM, BK]>\n"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:277
msgid ""
"Do not pass `Tile<f4e2m1fnx2, ...>` directly to `mmaf_scaled`. The MMA "
"operand is the unpacked logical `Tile<f4e2m1fn, ...>`. The method emits the "
"required rank-1 Tile IR `unpack` internally and reshapes the result back to "
"the requested tile shape."
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:284
msgid "Launch Shape"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:286
msgid ""
"For the kernel above, `BK` is the logical K tile width. The kernel walks the "
"K tiles of the packed activation partition with `num_tiles(&part_x, 1)`; the "
"host passes `BK` plus the derived packed and scale tile widths used in "
"static tile shapes:"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:291
msgid ""
"use cutile::api;\n"
"use cutile::tile_kernel::TileKernel;\n"
"use cutile::tensor::IntoPartition;\n"
"\n"
"let bm = 16usize;\n"
"let bn = 16usize;\n"
"let bk = 64usize;\n"
"let bk_packed = bk / 2;\n"
"let bk_scales = bk / 16;\n"
"let z = api::zeros::<f32>(&[m, n]).partition([bm, bn]);\n"
"\n"
"let (z, ..) = nvfp4_linear::linear_tile(\n"
"    z,\n"
"    x,\n"
"    y,\n"
"    x_scales,\n"
"    y_scales,\n"
"    alpha,\n"
")\n"
".generics(vec![\n"
"    bm.to_string(),\n"
"    bn.to_string(),\n"
"    bk.to_string(),\n"
"    bk_packed.to_string(),\n"
"    bk_scales.to_string(),\n"
"])\n"
".sync()?;\n"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:323
msgid "Architecture Tradeoffs"
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:325
msgid ""
"Packing FP4 values reduces operand bytes before the data reaches the kernel. "
"That can reduce memory traffic whenever the model is stored and moved in "
"packed form. The larger speedup comes when the target GPU also has hardware "
"support for block-scaled FP4 matrix multiply, because the compiler can lower "
"`mmaf_scaled` on logical `f4e2m1fn` tiles to NVFP4-specific Tensor Core "
"instructions."
msgstr ""

#: ../../../tutorials/11-nvfp4-inference.md:332
msgid ""
"CUDA Tile IR 13.3 supports `sm_80` and newer targets generally, but that "
"does not mean every Tile IR type or MMA operation is native on every target. "
"`mmaf_scaled` with scaled floating-point inputs is an `sm_100` and newer "
"operation, and `f4E2M1FN` is a Blackwell-supported Tile IR type."
msgstr ""

