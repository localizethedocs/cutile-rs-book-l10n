#: ../../../tutorials/05-fused-softmax.md:132
msgid "After reduction, reshape and broadcast to match the original tile:"
msgstr ""

#: ../../../tutorials/05-fused-softmax.md:134
msgid ""
"// [BM] → [BM, 1] → [BM, BN]\n"
"let tile_x_max: Tile<f32, { [BM, BN] }> =\n"
"    tile_x_max\n"
"    .reshape(shape![BM, 1])   // [2] → [2, 1]\n"
"    .broadcast(y.shape());           // [2, 1] → [2, 8]\n"
msgstr ""

#: ../../../tutorials/05-fused-softmax.md:145
msgid "Keeping intermediate values in registers"
msgstr ""

#: ../../../tutorials/05-fused-softmax.md:147
msgid "The fused kernel keeps its intermediate values in registers:"
msgstr ""

#: ../../../tutorials/05-fused-softmax.md:149
msgid ""
"// 1. LOAD once\n"
"let tile = input.load_like(output);\n"
"\n"
"// 2. ALL COMPUTATION in registers\n"
"let step1 = reduce_max(tile, axis);\n"
"let step2 = tile - step1.broadcast(...);\n"
"let step3 = exp(step2);\n"
"let step4 = reduce_sum(step3, axis);\n"
"let result = step3 / step4.broadcast(...);\n"
"\n"
"// 3. STORE once\n"
"output.store(result);\n"
msgstr ""

