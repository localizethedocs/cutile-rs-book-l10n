msgid "Comparison of unfused (4 kernels) vs fused (1 kernel) softmax"
msgstr ""

#: ../../../tutorials/05-fused-softmax.md:15
msgid "Numerical stability"
msgstr ""

#: ../../../tutorials/05-fused-softmax.md:17
msgid "Subtracting the row maximum before calling `exp` prevents overflow:"
msgstr ""

#: ../../../tutorials/05-fused-softmax.md:19
msgid ""
"x = [100, 101, 102]\n"
"exp(x) = [2.7×10⁴³, 7.3×10⁴³, 2.0×10⁴⁴]  ← Overflow! These are inf in "
"float32\n"
msgstr ""

#: ../../../tutorials/05-fused-softmax.md:24
msgid "With max subtraction:"
msgstr ""

#: ../../../tutorials/05-fused-softmax.md:26
msgid ""
"x = [100, 101, 102]\n"
"max = 102\n"
"x - max = [-2, -1, 0]\n"
"exp(x - max) = [0.135, 0.368, 1.0]  ← Safe values\n"
msgstr ""

#: ../../../tutorials/05-fused-softmax.md:33
msgid "The result is mathematically identical:"
msgstr ""

#: ../../../tutorials/05-fused-softmax.md:35
msgid ""
"exp(x_i - max) / Σ exp(x_j - max)\n"
"= [exp(x_i) / exp(max)] / [Σ exp(x_j) / exp(max)]\n"
"= exp(x_i) / Σ exp(x_j)\n"
msgstr ""

