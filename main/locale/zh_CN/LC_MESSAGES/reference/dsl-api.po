#: ../../../reference/dsl-api.md:92
msgid "Entry Points vs Device Functions"
msgstr ""

#: ../../../reference/dsl-api.md:94
msgid ""
"Functions marked with `#[cutile::entry()]` are compiled as GPU kernel entry "
"points — they can be launched from the host with a grid configuration."
msgstr ""

#: ../../../reference/dsl-api.md:96
msgid ""
"Unmarked functions inside a module are **device functions** — they are "
"inlined at the call site during compilation. They cannot be launched "
"directly but can be called from entry points or other device functions."
msgstr ""

#: ../../../reference/dsl-api.md:98
msgid ""
"#[cutile::module]\n"
"mod my_kernels {\n"
"    use cutile::core::*;\n"
"\n"
"    // Device function: inlined into callers\n"
"    fn relu<const S: [i32; 1]>(x: Tile<f32, S>) -> Tile<f32, S> {\n"
"        let zero: Tile<f32, S> = constant(0.0f32, x.shape());\n"
"        select(gt_tile(x, zero), x, zero)\n"
"    }\n"
"\n"
"    #[cutile::entry()]\n"
"    fn apply_relu<const S: [i32; 1]>(\n"
"        output: &mut Tensor<f32, S>,\n"
"        input: &Tensor<f32, { [-1] }>,\n"
"    ) {\n"
"        let pid = program_id(0);\n"
"        let tile: Tile<f32, S> = input.load_tile(shape!(S), [pid]);\n"
"        output.store(relu(tile));  // device function call, inlined\n"
"    }\n"
"}\n"
msgstr ""

#: ../../../reference/dsl-api.md:121
msgid "Inter-Module Device Function Calls"
msgstr ""

#: ../../../reference/dsl-api.md:123
msgid ""
"Device functions defined in one `#[cutile::module]` can be called from entry "
"points in another module. When Module B does `use crate::activations::*`, "
"two things happen:"
msgstr ""

#: ../../../reference/dsl-api.md:127
msgid ""
"**Rust's type checker** resolves the function signatures at compile time."
msgstr ""

#: ../../../reference/dsl-api.md:128
msgid ""
"**The macro** records Module A as a dependency of Module B, including Module "
"A's AST in the collected module list for JIT compilation."
msgstr ""

#: ../../../reference/dsl-api.md:131
msgid ""
"At JIT time, the compiler sees all dependent module ASTs and inlines device "
"functions from any of them into the entry point."
msgstr ""

#: ../../../reference/dsl-api.md:134
msgid ""
"Each module is identified by its fully-qualified path (via `module_path!"
"()`), so shared dependencies like `cutile::core` are automatically "
"deduplicated even when imported by multiple modules."
msgstr ""

#: ../../../reference/dsl-api.md:138
msgid ""
"/// Module A: reusable activation device functions (no entry points).\n"
"#[cutile::module]\n"
"mod activations {\n"
"    use cutile::core::*;\n"
"\n"
"    pub fn relu<const S: [i32; 1]>(x: Tile<f32, S>) -> Tile<f32, S> {\n"
"        let zero: Tile<f32, S> = constant(0.0f32, x.shape());\n"
"        max_tile(x, zero)\n"
"    }\n"
"\n"
"    pub fn square<const S: [i32; 1]>(x: Tile<f32, S>) -> Tile<f32, S> {\n"
"        x * x\n"
"    }\n"
"}\n"
"\n"
"/// Module B: kernels that call device functions from Module A.\n"
"#[cutile::module]\n"
"mod my_kernels {\n"
"    use cutile::core::*;\n"
"    use crate::activations::{relu, square};  // import from Module A\n"
"\n"
"    #[cutile::entry()]\n"
"    fn apply_relu_square<const S: [i32; 1]>(\n"
"        output: &mut Tensor<f32, S>,\n"
"        input: &Tensor<f32, { [-1] }>,\n"
"    ) {\n"
"        let pid = program_id(0);\n"
"        let tile: Tile<f32, S> = input.load_tile(shape!(S), [pid]);\n"
"        let activated: Tile<f32, S> = relu(tile);   // inlined from Module "
"A\n"
"        output.store(square(activated));             // inlined from Module "
"A\n"
"    }\n"
"}\n"
msgstr ""

#: ../../../reference/dsl-api.md:173
msgid "See `cutile-examples/examples/inter_module.rs` for a runnable version."
msgstr ""

#: ../../../reference/dsl-api.md:175
msgid "`cutile::core` internals"
msgstr ""

#: ../../../reference/dsl-api.md:177
msgid ""
"`cutile::core` (defined in `_core.rs`) is itself a `#[cutile::module]` "
"containing the built-in DSL operations. When you write `use cutile::core::*;"
"`, the macro records it as a dependency and includes its AST. The JIT "
"compiler then resolves calls to `constant`, `iota`, `mma`, `reduce_sum`, "
"etc. from core's AST and inlines them into your entry point — exactly the "
"same mechanism as user-defined inter-module calls."
msgstr ""

#: ../../../reference/dsl-api.md:186
msgid "Types"
msgstr ""

#: ../../../reference/dsl-api.md:188
msgid "Tile"
msgstr ""

#: ../../../reference/dsl-api.md:190
msgid ""
"`Tile<E: ElementType, const S: [i32; N]>` — A multi-dimensional array of GPU "
"values. This is the fundamental compute type. Tiles are register-resident "
"and processed in parallel by all threads in a warp/block."
msgstr ""

#: ../../../reference/dsl-api.md:192
msgid ""
"// Shapes are const generics\n"
"let a: Tile<f32, { [128] }>;          // 1D: 128 f32 elements\n"
"let b: Tile<f32, { [16, 16] }>;       // 2D: 16x16 matrix\n"
"let c: Tile<i32, { [4, 8, 2] }>;      // 3D\n"
"\n"
"// Scalar tile (rank 0)\n"
"let s: Tile<f32, { [] }>;\n"
msgstr ""

#: ../../../reference/dsl-api.md:202 ../../../reference/dsl-api.md:228
msgid "**Methods:**"
msgstr ""

#: ../../../reference/dsl-api.md:203
msgid "`tile.shape()` — Returns the tile's `Shape<S>`"
msgstr ""

#: ../../../reference/dsl-api.md:204
msgid "`tile.broadcast(shape)` — Broadcast to a larger shape"
msgstr ""

#: ../../../reference/dsl-api.md:205
msgid "`tile.reshape(shape)` — Reshape (must preserve element count)"
msgstr ""

#: ../../../reference/dsl-api.md:206
msgid "`tile.transpose()` — Transpose a rank-2 tile"
msgstr ""

#: ../../../reference/dsl-api.md:208
msgid ""
"**Arithmetic operators:** `+`, `-`, `*`, `/` are overloaded for element-wise "
"operations between tiles of the same shape and type. Integer `/` and `%` "
"follow Rust semantics: the quotient truncates toward zero (`-7 / 2 == -3`) "
"and the remainder takes the dividend's sign (`-7 % 2 == -1`); unsigned "
"element types divide as unsigned. Use `ceil_div` for a quotient rounded "
"toward positive infinity."
msgstr ""

#: ../../../reference/dsl-api.md:210
msgid ""
"let z: Tile<f32, { [128] }> = a + b;     // element-wise add\n"
"let w: Tile<f32, { [128] }> = a * b - c; // chained arithmetic\n"
msgstr ""

#: ../../../reference/dsl-api.md:215
msgid "Tensor"
msgstr ""

#: ../../../reference/dsl-api.md:217
msgid ""
"`Tensor<E: ElementType, const S: [i32; N]>` — A device-side tensor view. "
"Represents memory that lives in GPU global memory. Unlike `Tile`, tensors "
"must be loaded/stored explicitly."
msgstr ""

#: ../../../reference/dsl-api.md:219
msgid ""
"Static dimensions are known at compile time; dynamic dimensions are marked "
"with `-1`:"
msgstr ""

#: ../../../reference/dsl-api.md:221
msgid ""
"fn kernel(\n"
"    output: &mut Tensor<f32, { [128, 128] }>,  // static: 128x128\n"
"    input: &Tensor<f32, { [-1, -1] }>,          // dynamic: shape provided "
"at runtime\n"
")\n"
msgstr ""

#: ../../../reference/dsl-api.md:229
msgid "`tensor.shape()` — Returns the tensor's `Shape<S>`"
msgstr ""

#: ../../../reference/dsl-api.md:230
msgid ""
"`tensor.load()` — Load the entire tile (only for `&mut Tensor`, loads output "
"tile)"
msgstr ""

#: ../../../reference/dsl-api.md:231
msgid "`tensor.store(tile)` — Store a tile to the tensor"
msgstr ""

#: ../../../reference/dsl-api.md:232
msgid ""
"`tensor.load_tile(shape, [indices])` — Load a tile at a specific partition "
"index"
msgstr ""

#: ../../../reference/dsl-api.md:233
msgid ""
"`tensor.partition(shape)` — Create a `Partition` view for block-indexed "
"loading"
msgstr ""

#: ../../../reference/dsl-api.md:234
msgid ""
"`tensor.partition_permuted(shape, dim_map)` — Create a permuted `Partition` "
"view"
msgstr ""

#: ../../../reference/dsl-api.md:235
msgid ""
"`tensor.partition_mut(shape)` — Create a mutable `PartitionMut` view "
"(requires `&mut Tensor`; safe because every unproven store through the view "
"is itself `unsafe`)"
msgstr ""

#: ../../../reference/dsl-api.md:236
msgid ""
"`unsafe tensor.partition_full_mut(shape)` — Create a mutable `PartitionMut` "
"view over the full tensor, without the tile-block offset, for schedule-"
"driven kernels"
msgstr ""

#: ../../../reference/dsl-api.md:238
msgid "Partition / PartitionMut"
msgstr ""

#: ../../../reference/dsl-api.md:240
msgid ""
"`Partition<'a, E, const D: [i32; N]>` — A read-only partitioned view of a "
"tensor, dividing it into tiles indexed by program ID."
msgstr ""

#: ../../../reference/dsl-api.md:242
msgid "`PartitionMut<'a, E, const D: [i32; N]>` — A mutable partitioned view."
msgstr ""

#: ../../../reference/dsl-api.md:244
msgid ""
"let part: Partition<f32, { [128, 128] }> = input.partition(shape![128, "
"128]);\n"
"let tile: Tile<f32, { [128, 128] }> = part.load([pid_m, pid_n]);\n"
msgstr ""

#: ../../../reference/dsl-api.md:249
msgid "Shape / Array"
msgstr ""

#: ../../../reference/dsl-api.md:251
msgid ""
"`Shape<const D: [i32; N]>` — A compile-time shape descriptor. Created with "
"`shape!`:"
msgstr ""

#: ../../../reference/dsl-api.md:253
msgid ""
"let shape: Shape<{ [128, 64] }> = shape![128, 64];\n"
"let shape: Shape<S> = tensor.shape();\n"
msgstr ""

#: ../../../reference/dsl-api.md:258
msgid ""
"`Array<const D: [i32; N]>` — A compile-time array (used for strides and "
"indices)."
msgstr ""

#: ../../../reference/dsl-api.md:260
msgid "Const Generic Array (CGA) Syntax"
msgstr ""

#: ../../../reference/dsl-api.md:262
msgid ""
"Shapes can use literal dimensions, scalar const generics, or a const generic "
"array (`const S: [i32; N]`):"
msgstr ""

#: ../../../reference/dsl-api.md:265
msgid "**1. Explicit values** — when dimensions are known literals:"
msgstr ""

#: ../../../reference/dsl-api.md:267
msgid ""
"fn kernel(\n"
"    output: &mut Tensor<f32, { [128, 64] }>,   // fixed 128x64\n"
"    input: &Tensor<f32, { [-1, -1] }>,          // dynamic (runtime) shape\n"
")\n"
msgstr ""

#: ../../../reference/dsl-api.md:274
msgid ""
"**2. Const generic parameters** — when dimensions are specified at launch "
"time:"
msgstr ""

#: ../../../reference/dsl-api.md:276
msgid ""
"fn gemm<const BM: i32, const BN: i32, const BK: i32>(\n"
"    output: &mut Tensor<f32, { [BM, BN] }>,    // shape from generics\n"
"    a: &Tensor<f32, { [-1, -1] }>,\n"
")\n"
msgstr ""

#: ../../../reference/dsl-api.md:283
msgid ""
"**3. Const generic array (CGA)** — when the entire shape is a single generic "
"parameter:"
msgstr ""

#: ../../../reference/dsl-api.md:285
msgid ""
"fn add<const S: [i32; 1]>(                      // S is the whole shape\n"
"    output: &mut Tensor<f32, S>,\n"
"    input: &Tensor<f32, { [-1] }>,\n"
")\n"
msgstr ""

#: ../../../reference/dsl-api.md:292
msgid ""
"In `const S: [i32; N]`, the rank `N` must be a literal fixed at definition "
"time. It cannot itself be generic, so this form cannot make one kernel work "
"for both 1D and 2D tensors:"
msgstr ""

#: ../../../reference/dsl-api.md:296
msgid ""
"// NOT supported: generic rank\n"
"fn add<const N: usize, const S: [i32; N]>(output: &mut Tensor<f32, S>) "
"{ ... }\n"
"\n"
"// Instead, write separate kernels per rank:\n"
"fn add_1d<const S: [i32; 1]>(output: &mut Tensor<f32, S>) { ... }\n"
"fn add_2d<const S: [i32; 2]>(output: &mut Tensor<f32, S>) { ... }\n"
msgstr ""

