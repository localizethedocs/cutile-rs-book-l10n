#: ../../../reference/dsl-api.md:935
msgid ""
"These are `unsafe` — incorrect assumptions produce undefined behavior. They "
"enable compiler optimizations like vectorized loads and simplified index "
"arithmetic."
msgstr ""

#: ../../../reference/dsl-api.md:937
msgid ""
"// Tell the compiler a dimension is a multiple of 16 (enables wider vector "
"loads)\n"
"let dim: i32 = unsafe { assume_div_by::<_, 16>(dim) };\n"
"\n"
"// Bound an index (enables range-based optimizations)\n"
"let idx: i32 = unsafe { assume_bounds::<_, 0, 1024>(idx) };\n"
"\n"
"// Combine: non-negative and aligned\n"
"let stride: i32 = unsafe { assume_bounds_lower::<_, 0>(stride) };\n"
"let stride: i32 = unsafe { assume_div_by::<_, 4>(stride) };\n"
msgstr ""

