#: ../../../reference/dsl-api.md:829
msgid "Tokens"
msgstr ""

#: ../../../reference/dsl-api.md:831
msgid ""
"Tokens track ordering dependencies between memory operations. A token "
"returned from a load guarantees that the load has completed before any "
"operation that consumes that token. `join_tokens` merges multiple tokens "
"into one, ensuring all joined operations complete before the result token is "
"used."
msgstr ""

#: ../../../reference/dsl-api.md:833
msgid ""
"This enables fine-grained ordering without full barriers: independent loads "
"can execute in parallel, and a store only waits for the specific loads it "
"depends on."
msgstr ""

#: ../../../reference/dsl-api.md:0
msgid "`new_token_unordered()`"
msgstr ""

#: ../../../reference/dsl-api.md:0
msgid "`() -> Token`"
msgstr ""

#: ../../../reference/dsl-api.md:0
msgid "Create a fresh ordering token (no ordering guarantee)"
msgstr ""

#: ../../../reference/dsl-api.md:0
msgid "`join_tokens(tokens)`"
msgstr ""

#: ../../../reference/dsl-api.md:0
msgid "`(&[Token]) -> Token`"
msgstr ""

#: ../../../reference/dsl-api.md:0
msgid "Join multiple tokens: result waits for all inputs"
msgstr ""

#: ../../../reference/dsl-api.md:840
msgid ""
"// Thread tokens through a load → compute → store sequence:\n"
"let token: Token = new_token_unordered();\n"
"\n"
"// Load returns a new token guaranteeing the load completed\n"
"let (data, load_token): (Tile<f32, { [128] }>, Token) =\n"
"    load_ptr_tko(src_ptrs, ordering::Weak, None::<scope::TileBlock>, None, "
"None, None, Latency::<0>);\n"
"\n"
"// Compute on the loaded data\n"
"let result: Tile<f32, { [128] }> = data * data;\n"
"\n"
"// Store uses the load token: waits for the load before writing\n"
"let store_token: Token =\n"
"    store_ptr_tko(dst_ptrs, result, ordering::Weak, None::<scope::"
"TileBlock>, None, Some(load_token), Latency::<0>);\n"
msgstr ""

#: ../../../reference/dsl-api.md:856
msgid ""
"// Join tokens from two independent loads before a dependent store:\n"
"let (a_data, a_token): (Tile<f32, { [128] }>, Token) =\n"
"    load_ptr_tko(a_ptrs, ordering::Weak, None::<scope::TileBlock>, None, "
"None, None, Latency::<0>);\n"
"let (b_data, b_token): (Tile<f32, { [128] }>, Token) =\n"
"    load_ptr_tko(b_ptrs, ordering::Weak, None::<scope::TileBlock>, None, "
"None, None, Latency::<0>);\n"
"\n"
"// Both loads must complete before the store\n"
"let combined: Token = join_tokens(&[a_token, b_token]);\n"
"let result: Tile<f32, { [128] }> = a_data + b_data;\n"
"let _: Token =\n"
"    store_ptr_tko(out_ptrs, result, ordering::Weak, None::<scope::"
"TileBlock>, None, Some(combined), Latency::<0>);\n"
msgstr ""

