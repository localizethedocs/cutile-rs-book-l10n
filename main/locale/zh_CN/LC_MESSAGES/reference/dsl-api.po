#: ../../../reference/dsl-api.md:568
msgid ""
"// Softmax numerics: subtract max, exponentiate\n"
"let max_val: Tile<f32, { [BM] }> = reduce_max(x, 1i32);\n"
"let shifted: Tile<f32, S> = x - max_val.reshape(shape![BM, 1]).broadcast(x."
"shape());\n"
"let softmax_exp: Tile<f32, S> = exp(shifted);\n"
"\n"
"// RMS normalization\n"
"let sq: Tile<f32, S> = x * x;\n"
"let mean_sq: Tile<f32, { [BM] }> = reduce_sum(sq, 1i32);\n"
"let rms: Tile<f32, { [BM] }> =\n"
"    rsqrt(mean_sq + broadcast_scalar(1e-6f32, mean_sq.shape()), ftz::"
"Disabled);\n"
"\n"
"// Activation functions\n"
"let gelu_approx: Tile<f32, S> = x * (constant(1.0f32, x.shape()) + "
"tanh(x));\n"
"let swish: Tile<f32, S> = x / (constant(1.0f32, x.shape()) + exp(negf(x)));\n"
"\n"
"// exp2 is faster than exp on GPU — convert: exp(x) = exp2(x * log2(e))\n"
"let log2_e: f32 = 1.4426950408889634f32;\n"
"let fast_exp: Tile<f32, S> = exp2(x * broadcast_scalar(log2_e, x.shape()), "
"ftz::Disabled);\n"
"\n"
"// Flush-to-zero: pass ftz::Enabled to treat denormals as zero (faster on "
"some hardware, f32 only)\n"
"let clamped: Tile<f32, S> =\n"
"    maxf(x, broadcast_scalar(0.0f32, x.shape()), nan::Disabled, ftz::"
"Enabled);\n"
"let sum: Tile<f32, S> = addf(a, b, rounding::NearestEven, ftz::Enabled);\n"
"let product: Tile<f32, S> = mulf(a, b, rounding::NearestEven, ftz::"
"Enabled);\n"
"let fma_result: Tile<f32, S> = fma(a, b, c, rounding::NearestEven, ftz::"
"Enabled);\n"
msgstr ""

