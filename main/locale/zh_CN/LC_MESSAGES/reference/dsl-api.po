"    let a_tile: Tile<f32, { [16, 8] }> = a_part.load([pid_m, k]);\n"
"    let b_tile: Tile<f32, { [8, 16] }> = b_part.load([k, pid_n]);\n"
"    acc = mma(a_tile, b_tile, acc);\n"
