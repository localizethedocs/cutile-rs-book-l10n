#: ../../../reference/dsl-api.md:58
msgid ""
"`unchecked_accesses` disables verification and requires `unsafe`. "
"`deny_in_kernel_checks` keeps verification but rejects checks that remain "
"inside the kernel."
msgstr ""

#: ../../../reference/dsl-api.md:62
msgid ""
"#[cutile::entry(print_ir = true)]\n"
"fn debug_kernel<const S: [i32; 1]>(output: &mut Tensor<f32, S>) { ... }\n"
"\n"
"// Unsafe: skip all checks, no verification.\n"
"#[cutile::entry(unchecked_accesses)]\n"
"unsafe fn fast_kernel<const S: [i32; 1]>(output: &mut Tensor<f32, S>) "
"{ ... }\n"
"\n"
"// Safe + strict: fail to compile if any safety check would stay in the "
"kernel.\n"
"#[cutile::entry(deny_in_kernel_checks = true)]\n"
"fn zero_check_kernel<const S: [i32; 1]>(output: &mut Tensor<f32, S>) "
"{ ... }\n"
"\n"
"#[cutile::entry(dump_mlir_dir = \"/tmp/cutile-ir\")]\n"
"fn traced_kernel<const S: [i32; 1]>(output: &mut Tensor<f32, S>) { ... }\n"
msgstr ""

