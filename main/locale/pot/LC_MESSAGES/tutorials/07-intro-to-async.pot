#: ../../../tutorials/07-intro-to-async.md:24
msgid "DeviceOp"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:26
msgid ""
"`DeviceOp` describes GPU work without executing it. `.await` or `."
"sync_on(.)` executes the operation; `tokio::spawn` can run the future "
"produced by `into_future()` or `.schedule(...)`."
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:30
msgid ""
"// This creates a DeviceOp, but doesn't execute yet!\n"
"let tensor_op = api::ones(&[1024, 1024]);  // Returns impl DeviceOp\n"
"\n"
"// Nothing has happened on the GPU yet...\n"
"\n"
"// NOW it executes:\n"
"let tensor: Tensor<f32> = tensor_op.sync_on(&stream)?;  // Sync API\n"
"// or\n"
"let tensor: Tensor<f32> = tensor_op.await?;             // Async API\n"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:44
msgid "Sync vs Async APIs"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:46
msgid ""
"In cutile, a `DeviceOp` can be executed with either sync or async APIs. "
"Given a particular operation `op`:"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:0
msgid "API"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:0
msgid "Description"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:0
msgid "`op.sync()`"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:0
msgid ""
"Immediately executes `op` on the default GPU device (device 0). Blocking. "
"Callable outside of async context."
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:0
msgid "`op.sync_on(&stream)`"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:0
msgid ""
"Immediately executes `op` on `stream`. Blocking. Callable outside of async "
"context."
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:0
msgid "`op.await`"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:0
msgid ""
"Immediately executes `op` as part of the async context from which it is "
"invoked. Blocks the enclosing async context but frees the executing thread, "
"allowing the runtime to schedule other tasks on it. Can only be called from "
"within an async context."
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:0
msgid "`tokio::spawn(op.into_future())`"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:0
msgid ""
"Submits the operation's future to the async runtime, returning a handle that "
"can later be awaited. Non-blocking. Can only be called from within an async "
"context."
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:55
msgid ""
"Note: An async context is any code appearing in a block defined with the "
"`async` keyword, e.g. `async fn ...`, `async { ... }`, `async || { ... }`."
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:59
msgid "Async Vector Addition"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:61
msgid ""
"use cutile::api::{ones, zeros};\n"
"use cutile::tensor::{Tensor, ToHostVec, Unpartition};\n"
"use cutile::tile_kernel::{PartitionOp, TileKernel, ToHostVecOp};\n"
"use cuda_async::device_operation::*;\n"
"use cuda_async::error::DeviceError;\n"
"use std::sync::Arc;\n"
"\n"
"#[cutile::module]\n"
"mod async_add_module {\n"
"    use cutile::core::*;\n"
"\n"
"    #[cutile::entry()]\n"
"    fn add<const S: [i32; 2]>(\n"
"        z: &mut Tensor<f32, S>,\n"
"        x: &Tensor<f32, {[-1, -1]}>,\n"
"        y: &Tensor<f32, {[-1, -1]}>\n"
"    ) {\n"
"        let tile_x = x.load_like(z);\n"
"        let tile_y = y.load_like(z);\n"
"        z.store(tile_x + tile_y);\n"
"    }\n"
"}\n"
"\n"
"use async_add_module::add;\n"
"\n"
"#[tokio::main]\n"
"async fn main() -> Result<(), DeviceError> {\n"
"    let x: Arc<Tensor<f32>> = ones(&[32, 32]).map(Into::into).await?;\n"
"    let y: Arc<Tensor<f32>> = ones(&[32, 32]).map(Into::into).await?;\n"
"\n"
"    // Unified launcher: pass output partition and inputs directly.\n"
"    let z_host: Vec<f32> = add(\n"
"        zeros(&[32, 32]).partition([4, 4]),  // Output, partitioned into "
"tiles\n"
"        x,                                    // Input x (Arc<Tensor> via "
"IntoDeviceOp)\n"
"        y,                                    // Input y\n"
"    )\n"
"    .first()\n"
"    .unpartition()\n"
"    .to_host_vec()\n"
"    .await?;\n"
"    println!(\"z[0] = {} (expected 2.0)\", z_host[0]);\n"
"    Ok(())\n"
"}\n"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:107
msgid "**Output:**"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:109
msgid "z[0] = 2 (expected 2.0)\n"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:115
msgid "Overlapping Work with Spawn"
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:117
msgid ""
"`.await` suspends the current task until the operation completes, freeing "
"its thread to run other tasks. `tokio::spawn` starts a separate task and "
"returns a handle immediately. Await that handle when you need the result."
msgstr ""

#: ../../../tutorials/07-intro-to-async.md:121
msgid ""
"#[tokio::main]\n"
"async fn main() -> Result<(), DeviceError> {\n"
"    let batch1_op = prepare_batch(1);  // Returns DeviceOp\n"
"    let batch2_op = prepare_batch(2);  // Returns DeviceOp\n"
"\n"
"    let batch1 = batch1_op.await?;\n"
"\n"
"    let result1_op = process_kernel(batch1);\n"
"    let result1_handle = tokio::spawn(result1_op.into_future());  // Non-"
"blocking\n"
"\n"
"    // batch 2 data can be prepared while batch 1's kernel runs\n"
"    let batch2 = batch2_op.await?;\n"
"\n"
"    let result2 = process_kernel(batch2).await?;\n"
"\n"
"    let result1 = result1_handle.await.expect(\"task panicked\")?;\n"
"    Ok(())\n"
"}\n"
msgstr ""

