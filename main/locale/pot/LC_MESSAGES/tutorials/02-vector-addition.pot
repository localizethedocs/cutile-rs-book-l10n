#: ../../../tutorials/02-vector-addition.md:141
msgid "The Load/Store Pattern"
msgstr ""

#: ../../../tutorials/02-vector-addition.md:143
msgid "Almost every kernel follows this pattern:"
msgstr ""

#: ../../../tutorials/02-vector-addition.md:145
msgid ""
"fn my_kernel(...) {\n"
"    // 1. LOAD: Global memory → tiles (registers).\n"
"    let tile_a = load_something(...);\n"
"    let tile_b = load_something_else(...);\n"
"    \n"
"    // 2. COMPUTE: Operate on tiles in registers.\n"
"    let result = tile_a + tile_b;\n"
"    \n"
"    // 3. STORE: Tiles (registers) → global memory.\n"
"    output.store(result);\n"
"}\n"
msgstr ""

