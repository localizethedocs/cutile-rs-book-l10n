#: ../../../guide/debugging-and-profiling.md:1
msgid "Debugging and Profiling"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:3
msgid ""
"Start debugging with small, deterministic inputs. Read results back to the "
"host, compare against a CPU reference, then inspect generated Tile IR or "
"profile the GPU when correctness is established."
msgstr ""

#: ../../../guide/debugging-and-profiling.md:5
msgid "Printing and Assertions"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:7
msgid "`cuda_tile_print!` prints from inside a GPU kernel:"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:9
msgid ""
"#[cutile::entry()]\n"
"fn debug_kernel<const S: [i32; 2]>(\n"
"    z: &mut Tensor<f32, S>,\n"
"    x: &Tensor<f32, { [-1, -1] }>,\n"
") {\n"
"    let pid0 = program_id(0);\n"
"    let pid1 = program_id(1);\n"
"    let tile = x.load_like(z);\n"
"\n"
"    cuda_tile_print!(\"Program ({}, {}): loaded tile\\n\", pid0, pid1);\n"
"    z.store(tile);\n"
"}\n"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:24
msgid ""
"GPU printing is slow and serializes tile block execution. Use it for small "
"grids and remove it before measuring performance."
msgstr ""

#: ../../../guide/debugging-and-profiling.md:26
msgid "`cuda_tile_assert!` checks conditions inside a kernel:"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:28
msgid ""
"let n: i32 = x.shape()[0];\n"
"cuda_tile_assert!(n > 0, \"expected a non-empty input\");\n"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:33
msgid "Host Readback"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:35
msgid ""
"Host readback is a `DeviceOp`; execute it before reading the host vector:"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:37
msgid ""
"let z_host: Vec<f32> = z\n"
"    .unpartition()\n"
"    .to_host_vec()\n"
"    .sync_on(&stream)?;\n"
"\n"
"assert!(!z_host.iter().any(|x| x.is_nan()));\n"
"assert!(!z_host.iter().any(|x| x.is_infinite()));\n"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:47
msgid ""
"If a fused kernel is wrong, split it into stages and read back each "
"intermediate. Each stage should match a simple CPU implementation on a small "
"input."
msgstr ""

#: ../../../guide/debugging-and-profiling.md:49
msgid "Correctness Tests"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:51
msgid "Use minimal inputs first:"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:53
msgid ""
"#[test]\n"
"fn small_add_matches_cpu() {\n"
"    let a = vec![1.0, 2.0, 3.0, 4.0];\n"
"    let b = vec![10.0, 20.0, 30.0, 40.0];\n"
"    let expected = vec![11.0, 22.0, 33.0, 44.0];\n"
"\n"
"    let result = run_add_kernel(&a, &b);\n"
"    assert_eq!(result, expected);\n"
"}\n"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:65
msgid ""
"Then compare larger random inputs against a CPU reference with an "
"appropriate tolerance:"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:67
msgid ""
"for (cpu, gpu) in cpu_result.iter().zip(gpu_result.iter()) {\n"
"    assert!((cpu - gpu).abs() < 1e-5, \"CPU={cpu}, GPU={gpu}\");\n"
"}\n"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:73
msgid ""
"For numerically sensitive kernels, test edge cases: zeros, large positive "
"values, large negative values, non-divisible shapes if supported, and known "
"overflow-prone inputs."
msgstr ""

#: ../../../guide/debugging-and-profiling.md:75
msgid "Inspecting Tile IR"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:77
msgid ""
"`print_ir = true` prints the generated entry point wrapper and the Tile IR "
"text during JIT compilation:"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:79
msgid ""
"#[cutile::entry(print_ir = true)]\n"
"fn debug_ir_kernel<const S: [i32; 2]>(...) { ... }\n"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:84
msgid "`dump_mlir_dir` writes the compiled Tile IR text to files:"
msgstr ""

#: ../../../guide/debugging-and-profiling.md:86
msgid ""
"#[cutile::entry(dump_mlir_dir = \"/tmp/cutile-ir\")]\n"
"fn debug_ir_kernel<const S: [i32; 2]>(...) { ... }\n"
msgstr ""

