#: ../../../reference/host-api.md:717
msgid "Error Handling Patterns"
msgstr ""

#: ../../../reference/host-api.md:719
msgid ""
"// Pattern 1: Propagate with ?\n"
"let x = api::zeros(&[1024]).sync_on(&stream)?;\n"
"\n"
"// Pattern 2: Match specific errors\n"
"match my_kernel(args).sync_on(&stream) {\n"
"    Ok(result) => { /* use result */ }\n"
"    Err(DeviceError::Launch(msg)) => {\n"
"        eprintln!(\"launch precondition failed: {msg}\");\n"
"    }\n"
"    Err(DeviceError::Anyhow(msg)) => {\n"
"        eprintln!(\"compile, grid, or tensor error: {msg}\");\n"
"    }\n"
"    Err(e) => return Err(e.into()),\n"
"}\n"
msgstr ""

#: ../../../reference/host-api.md:736
msgid "cutile::error::Error vs DeviceError"
msgstr ""

#: ../../../reference/host-api.md:738
msgid ""
"`cutile::error::Error` is the top-level error type that wraps `DeviceError` "
"alongside other error categories (I/O, shape mismatches, etc.). Functions "
"that only do GPU work return `DeviceError`; functions that mix host and "
"device work (like the examples) return `cutile::error::Error`."
msgstr ""

#: ../../../reference/host-api.md:746
msgid "CUDA Graph Integration"
msgstr ""

#: ../../../reference/host-api.md:748
msgid "Combinator approach: `.graph_on(stream)`"
msgstr ""

#: ../../../reference/host-api.md:750
msgid "Any `DeviceOp` can be captured into a replayable CUDA graph:"
msgstr ""

#: ../../../reference/host-api.md:752
msgid ""
"let forward_op = build_forward(&cfg, &weights, input, buffers);\n"
"let mut graph = forward_op.graph_on(stream.clone())?;\n"
"let output = graph.take_output().unwrap();\n"
"\n"
"// Replay loop — no graph rebuilding, no kernel re-compilation.\n"
"for token in tokens {\n"
"    graph.update(api::memcpy(&mut input_buf, &token))?;\n"
"    graph.launch().sync_on(&stream)?;\n"
"}\n"
msgstr ""

#: ../../../reference/host-api.md:764
msgid "This requires `Arc<Tensor<T>>` + `try_partition` for shared buffers."
msgstr ""

#: ../../../reference/host-api.md:766
msgid "Scope approach: `CudaGraph::scope`"
msgstr ""

#: ../../../reference/host-api.md:768
msgid ""
"`CudaGraph::scope` provides an imperative alternative using `&mut` borrows "
"instead of `Arc`. Each `s.record(op)` records a graph node and releases "
"borrows immediately. A buffer written by one `record` call can be read by "
"the next:"
msgstr ""

#: ../../../reference/host-api.md:773
msgid ""
"let mut output = api::zeros::<f32>(&[d]).sync_on(&stream)?;\n"
"let weights = api::ones::<f32>(&[d]).sync_on(&stream)?;\n"
"\n"
"let graph = CudaGraph::scope(&stream, |s| {\n"
"    s.record(kernel1((&mut output).partition([128]), &weights))?;\n"
"    s.record(kernel2((&mut output).partition([64]), &weights))?;\n"
"    Ok(())\n"
"})?;\n"
"\n"
"graph.launch().sync_on(&stream)?;\n"
msgstr ""

#: ../../../reference/host-api.md:786
msgid ""
"`record` only accepts operations that implement `GraphNode` — kernel "
"launches and `memcpy`. Allocation ops (`zeros`, `ones`, `dup`) are rejected "
"at compile time because their addresses may change on replay."
msgstr ""

