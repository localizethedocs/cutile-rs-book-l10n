#: ../../../reference/host-api.md:168
msgid ""
"// Host -> device\n"
"let data: Arc<Vec<f32>> = Arc::new(vec![1.0; 1024]);\n"
"let tensor: Tensor<f32> = api::copy_host_vec_to_device(&data)."
"sync_on(&stream)?;\n"
"\n"
"// Device -> host\n"
"let result: Vec<f32> = tensor.to_host_vec().sync_on(&stream)?;\n"
"\n"
"// Device -> device\n"
"let copy = tensor.dup().sync_on(&stream)?;\n"
msgstr ""

#: ../../../reference/host-api.md:180
msgid ""
"The host-side `Vec` must remain alive until the op completes — the async "
"copy reads from it until the stream synchronizes. `Arc<Vec<T>>` makes this "
"straightforward for shared access. `to_host_vec` is available on "
"`Tensor<T>`, `Arc<Tensor<T>>`, and `&Arc<Tensor<T>>`; each returns the same "
"`DeviceOp<Output = Vec<T>>`. It is also available on a `DeviceOp<Output = "
"Tensor<T>>`, which is the common form after a kernel chain:"
msgstr ""

#: ../../../reference/host-api.md:187
msgid ""
"let host: Vec<f32> = kernel(out.partition([128]), &input)\n"
"    .first()\n"
"    .unpartition()\n"
"    .to_host_vec()\n"
"    .sync_on(&stream)?;\n"
msgstr ""

#: ../../../reference/host-api.md:195
msgid ""
"`api::memcpy` copies between already allocated tensors and panics if the "
"source and destination element counts differ. It is the usual way to update "
"graph input buffers before replay:"
msgstr ""

#: ../../../reference/host-api.md:199
msgid ""
"graph.update(api::memcpy(&mut input_buffer, &new_input))?;\n"
"graph.launch().sync_on(&stream)?;\n"
msgstr ""

