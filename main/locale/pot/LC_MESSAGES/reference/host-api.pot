#: ../../../reference/host-api.md:90
msgid ""
"`reinterpret` requires an `Arc<Tensor<T>>`, contiguous storage, matching "
"total byte size, and compatible pointer alignment:"
msgstr ""

#: ../../../reference/host-api.md:93
msgid ""
"use cutile::tensor::Tensor;\n"
"use std::sync::Arc;\n"
"\n"
"let raw: Arc<Tensor<u32>> = api::arange::<u32>(4).sync_on(&stream)?.into();\n"
"let floats: Arc<Tensor<f32>> = raw.reinterpret::<f32>(&[4])?;\n"
"assert_eq!(floats.shape(), &[4]);\n"
msgstr ""

#: ../../../reference/host-api.md:102
msgid ""
"Packed FP4 model bytes can use the same zero-copy metadata path. If an "
"interoperability layer gives you byte storage, reinterpret it as "
"`f4e2m1fnx2` before launching kernels that expect typed packed FP4 tensors:"
msgstr ""

#: ../../../reference/host-api.md:106
msgid ""
"use cutile::api::{self, DeviceOpReshape};\n"
"use cutile::cuda_core::f4e2m1fnx2;\n"
"use cutile::tensor::Tensor;\n"
"use std::sync::Arc;\n"
"\n"
"let packed_bytes: Arc<Vec<u8>> = Arc::new(model_bytes);\n"
"let raw: Arc<Tensor<u8>> = api::copy_host_vec_to_device(&packed_bytes)\n"
"    .reshape(&[m, k / 2])\n"
"    .sync_on(&stream)?\n"
"    .into();\n"
"let fp4: Arc<Tensor<f4e2m1fnx2>> = raw.reinterpret::<f4e2m1fnx2>(&[m, k / "
"2])?;\n"
msgstr ""

#: ../../../reference/host-api.md:120
msgid ""
"`reinterpret` does not repack or validate the FP4 payload. It preserves the "
"bytes and changes the tensor element type metadata, so the producer of "
"`model_bytes` is responsible for the low-nibble, high-nibble packing order."
msgstr ""

#: ../../../reference/host-api.md:124
msgid "`TensorView`: zero-copy views and slices"
msgstr ""

#: ../../../reference/host-api.md:126
msgid ""
"`TensorView` provides zero-copy borrowed views of a tensor with a different "
"shape or offset. Views borrow the underlying tensor — the tensor cannot be "
"mutated while a view exists. The offset is applied host-side, so passing a "
"view to a kernel hands the kernel a pointer to the correct starting address "
"without any data movement."
msgstr ""

#: ../../../reference/host-api.md:0 ../../../reference/host-api.md:463
msgid "Method"
msgstr ""

#: ../../../reference/host-api.md:0
msgid "`tensor.view(&shape)`"
msgstr ""

#: ../../../reference/host-api.md:0
msgid ""
"Reshape to the given shape without copying. Total element count must match."
msgstr ""

#: ../../../reference/host-api.md:0
msgid "`tensor.slice(&ranges)`"
msgstr ""

#: ../../../reference/host-api.md:0
msgid "Borrow a rectangular sub-region (one numpy-style range per dimension)."
msgstr ""

#: ../../../reference/host-api.md:0
msgid "`view.slice(&ranges)`"
msgstr ""

#: ../../../reference/host-api.md:0
msgid "Chain-slice further; offsets accumulate."
msgstr ""

#: ../../../reference/host-api.md:134
msgid ""
"let tensor = api::arange::<f32>(1024).sync_on(&stream)?;\n"
"\n"
"// Reshape without copying.\n"
"let matrix = tensor.view(&[32, 32])?;\n"
"\n"
"// Slice: borrow a subregion (numpy-style ranges).\n"
"let first_half = tensor.slice(&[0..512])?;       // elements 0-511\n"
"let row_slice = matrix.slice(&[1..3])?;          // rows 1-2, all columns\n"
"let block = matrix.slice(&[1..3, 2..6])?;        // rows 1-2, cols 2-5\n"
"\n"
"// Chained slices accumulate offsets.\n"
"let inner = tensor.slice(&[100..200])?.slice(&[10..20])?;  // = "
"tensor[110..120]\n"
msgstr ""

#: ../../../reference/host-api.md:149
msgid ""
"Pass views and slices to kernels as `&Tensor` parameters to process part of "
"an existing tensor without allocation or copying."
msgstr ""

