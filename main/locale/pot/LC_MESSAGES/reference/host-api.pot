#: ../../../reference/host-api.md:296
msgid ""
"use cuda_core::LaunchConfig;\n"
"\n"
"LaunchConfig {\n"
"    grid_dim: ((n + 255) / 256, 1, 1),    // 3D grid of thread blocks\n"
"    block_dim: (256, 1, 1),                // 3D block of threads\n"
"    shared_mem_bytes: 0,                   // Dynamic shared memory per "
"block\n"
"}\n"
msgstr ""

#: ../../../reference/host-api.md:306
msgid ""
"**`AsyncKernelLaunch`** — wraps a CUDA driver kernel launch as a `DeviceOp`. "
"Build the argument list with `push_arg` (safe, for `DType` scalars) or "
"`push_device_ptr` (`unsafe`, for raw device pointers), set the launch "
"config, then `.await` or `.sync_on()`:"
msgstr ""

#: ../../../reference/host-api.md:308
msgid ""
"use cuda_async::launch::AsyncKernelLaunch;\n"
"\n"
"let mut launcher = AsyncKernelLaunch::new(function.clone());\n"
"launcher.push_arg(num_elements as u32);\n"
"launcher.push_arg(scale);\n"
"let input_ptr = input.device_pointer();\n"
"let output_ptr = output.device_pointer();\n"
"unsafe {\n"
"    launcher\n"
"        .push_device_ptr(input_ptr.cu_deviceptr())\n"
"        .push_device_ptr(output_ptr.cu_deviceptr());\n"
"}\n"
"launcher.set_launch_config(LaunchConfig {\n"
"    grid_dim: ((num_elements as u32 + 255) / 256, 1, 1),\n"
"    block_dim: (256, 1, 1),\n"
"    shared_mem_bytes: 0,\n"
"});\n"
"launcher.await?;  // Executes as a DeviceOp\n"
msgstr ""

#: ../../../reference/host-api.md:329
msgid ""
"See [Interoperability](../guide/interoperability.md) for the full "
"walkthrough and the wrapper pattern that hides `unsafe` at the call site."
msgstr ""

