#: ../../../tutorials/03-saxpy.md:154
msgid ""
"fn saxpy_extended<const S: [i32; 2]>(\n"
"    y: &mut Tensor<f32, S>,\n"
"    a: f32, b: f32,\n"
"    x: &Tensor<f32, {[-1, -1]}>\n"
") {\n"
"    let tile_a = a.broadcast(y.shape());\n"
"    let tile_b = b.broadcast(y.shape());\n"
"    let tile_x = x.load_like(y);\n"
"    let tile_y = y.load();\n"
"    y.store(tile_a * tile_x + tile_b * tile_y);\n"
"}\n"
msgstr ""

