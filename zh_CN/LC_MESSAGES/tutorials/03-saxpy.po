#: ../../../tutorials/03-saxpy.md:1
msgid "3. SAXPY"
msgstr ""

#: ../../../tutorials/03-saxpy.md:3
msgid ""
"SAXPY stands for **S**ingle-precision **A**·**X** **P**lus **Y** — a classic "
"numerical computing operation where a scalar multiplies a vector and the "
"result is added to another vector:"
msgstr ""

#: ../../../tutorials/03-saxpy.md:5
msgid "y = a * x + y    where a is a scalar, x and y are vectors\n"
msgstr ""

#: ../../../tutorials/03-saxpy.md:9
msgid ""
"cuTile arithmetic operates on tiles. To multiply a tile by a scalar, "
"**broadcast** the scalar to the tile's shape."
msgstr ""

#: ../../../tutorials/03-saxpy.md:14
msgid "Broadcasting"
msgstr ""

#: ../../../tutorials/03-saxpy.md:16
msgid ""
"Broadcasting takes a smaller value and replicates it to match a larger shape:"
msgstr ""

#: ../../../tutorials/03-saxpy.md:18
msgid ""
"![Broadcasting transforms a scalar into a tile](../_static/images/saxpy-"
"broadcasting.svg)"
msgstr ""

#: ../../../tutorials/03-saxpy.md:18
msgid "Broadcasting transforms a scalar into a tile"
msgstr ""

#: ../../../tutorials/03-saxpy.md:20
msgid ""
"The compiler implements broadcasting without allocating memory for the "
"copies."
msgstr ""

#: ../../../tutorials/03-saxpy.md:24
msgid ""
"use cuda_async::device_operation::DeviceOp;\n"
"use cuda_core::Device;\n"
"use std::sync::Arc;\n"
"use cutile;\n"
"use cutile::api::arange;\n"
"use cutile::error::Error;\n"
"use cutile::tensor::{IntoPartition, Reshape, Tensor, ToHostVec, "
"Unpartition};\n"
"\n"
"#[cutile::module]\n"
"mod my_module {\n"
"    use cutile::core::*;\n"
"\n"
"    #[cutile::entry()]\n"
"    fn saxpy<const S: [i32; 2]>(\n"
"        y: &mut Tensor<f32, S>,            // Vector input AND output (in-"
"place)\n"
"        a: f32,                           // Scalar input\n"
"        x: &Tensor<f32, { [-1, -1] }>     // Vector input\n"
"    ) {\n"
"        let tile_a = a.broadcast(y.shape());  // Scalar → Tile\n"
"        let tile_x = x.load_like(y);\n"
"        let tile_y = y.load();                // Load current y values\n"
"        y.store(tile_a * tile_x + tile_y);    // y = a*x + y\n"
"    }\n"
"}\n"
"\n"
"use my_module::saxpy;\n"
"\n"
"fn main() -> Result<(), Error> {\n"
"    let device = Device::new(0)?;\n"
"    let stream = device.new_stream()?;\n"
"    \n"
"    let a = 2.0f32;  // Our scalar multiplier\n"
"    \n"
"    // Create x and y as [0, 1, 2, ..., 31] reshaped to 4×8\n"
"    let input: Arc<Tensor<f32>> = arange(32usize).sync_on(&stream)?.into();\n"
"    let x: Arc<Tensor<f32>> = input.dup().sync_on(&stream)?.reshape(&[4, "
"8])?.into();\n"
"    let y = input.dup().sync_on(&stream)?.reshape(&[4, 8])?.partition([2, "
"2]);\n"
"    \n"
"    // Run: y = 2.0 * x + y = 2*x + x = 3*x\n"
"    let (y, a, _x) = saxpy(y, a, x).sync_on(&stream)?;\n"
"    let y_host: Vec<f32> = y.unpartition().to_host_vec().sync_on(&stream)?;\n"
"    \n"
"    // Verify\n"
"    for i in 0..5 {\n"
"        println!(\"{} * {} + {} = {} (got {})\", a, i, i, 3 * i, "
"y_host[i]);\n"
"    }\n"
"    \n"
"    Ok(())\n"
"}\n"
msgstr ""

#: ../../../tutorials/03-saxpy.md:76
msgid "**Output:**"
msgstr ""

#: ../../../tutorials/03-saxpy.md:78
msgid ""
"2 * 0 + 0 = 0 (got 0)\n"
"2 * 1 + 1 = 3 (got 3)\n"
"2 * 2 + 2 = 6 (got 6)\n"
"2 * 3 + 3 = 9 (got 9)\n"
"2 * 4 + 4 = 12 (got 12)\n"
msgstr ""

#: ../../../tutorials/03-saxpy.md:88
msgid "In-Place Operations"
msgstr ""

#: ../../../tutorials/03-saxpy.md:90
msgid "`y` is both an input and output:"
msgstr ""

#: ../../../tutorials/03-saxpy.md:92
msgid ""
"let tile_y = y.load();             // Read current y\n"
"y.store(tile_a * tile_x + tile_y); // Write new y\n"
msgstr ""

#: ../../../tutorials/03-saxpy.md:97
msgid ""
"This is an **in-place operation** — updating `y` rather than creating a new "
"tensor. In-place updates reuse existing memory, avoiding the cost of a new "
"allocation. SAXPY is traditionally in-place because it's used in iterative "
"algorithms where `y` is repeatedly updated."
msgstr ""

#: ../../../tutorials/03-saxpy.md:101
msgid "Memory Flow"
msgstr ""

#: ../../../tutorials/03-saxpy.md:103
msgid ""
"![SAXPY memory flow showing data moving from global memory through registers "
"and back](../_static/images/saxpy-memory-flow.svg)"
msgstr ""

#: ../../../tutorials/03-saxpy.md:103
msgid ""
"SAXPY memory flow showing data moving from global memory through registers "
"and back"
msgstr ""

#: ../../../tutorials/03-saxpy.md:105
msgid "Global memory is **slow** (hundreds of cycles to access)."
msgstr ""

#: ../../../tutorials/03-saxpy.md:106
msgid "Registers are **fast** (single cycle)."
msgstr ""

#: ../../../tutorials/03-saxpy.md:107
msgid "Intermediate results stay in registers between the load and store."
msgstr ""

#: ../../../tutorials/03-saxpy.md:109
msgid ""
"Combining operations in one kernel (**kernel fusion**) avoids writing "
"intermediate results to global memory."
msgstr ""

#: ../../../tutorials/03-saxpy.md:114
msgid "`y.shape()`"
msgstr ""

#: ../../../tutorials/03-saxpy.md:116
msgid "In the kernel:"
msgstr ""

#: ../../../tutorials/03-saxpy.md:118
msgid "let tile_a = a.broadcast(y.shape());\n"
msgstr ""

#: ../../../tutorials/03-saxpy.md:122
msgid ""
"`y.shape()` returns the compile-time known shape of the output partition "
"(`[2, 2]` in our case). This tells broadcast exactly what size tile to "
"create."
msgstr ""

