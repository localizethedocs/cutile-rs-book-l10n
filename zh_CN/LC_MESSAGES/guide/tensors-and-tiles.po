#: ../../../guide/tensors-and-tiles.md:137
msgid "Broadcasting and Reductions"
msgstr ""

#: ../../../guide/tensors-and-tiles.md:139
msgid ""
"Broadcasting expands a scalar or smaller tile to match a larger tile shape. "
"It follows NumPy-style rules: align dimensions from the right; each "
"dimension must either match or be 1."
msgstr ""

#: ../../../guide/tensors-and-tiles.md:141
msgid ""
"let bias: Tile<f32, { [1, BN] }> = ...;\n"
"let x: Tile<f32, { [BM, BN] }> = ...;\n"
"let y = x + bias.broadcast(shape![BM, BN]);\n"
msgstr ""

#: ../../../guide/tensors-and-tiles.md:147
msgid ""
"Reductions collapse one axis. Reshape the reduced result before broadcasting "
"it back:"
msgstr ""

#: ../../../guide/tensors-and-tiles.md:149
msgid ""
"fn softmax<const BM: i32, const BN: i32>(\n"
"    x: Tile<f32, { [BM, BN] }>,\n"
") -> Tile<f32, { [BM, BN] }> {\n"
"    let max = reduce_max(x, 1i32)\n"
"        .reshape(shape![BM, 1])\n"
"        .broadcast(shape![BM, BN]);\n"
"    let stable = x - max;\n"
"\n"
"    let exp_x = exp(stable);\n"
"    let sum = reduce_sum(exp_x, 1i32)\n"
"        .reshape(shape![BM, 1])\n"
"        .broadcast(shape![BM, BN]);\n"
"\n"
"    true_div(exp_x, sum)\n"
"}\n"
msgstr ""

#: ../../../guide/tensors-and-tiles.md:167
msgid "Numerically Stable Softmax"
msgstr ""

#: ../../../guide/tensors-and-tiles.md:169
msgid ""
"Subtract the per-row maximum before `exp` when implementing softmax. This "
"prevents overflow on large positive inputs and is the pattern used in fused "
"softmax and attention kernels."
msgstr ""

#: ../../../guide/tensors-and-tiles.md:171
msgid "Tiled Matrix Multiply"
msgstr ""

#: ../../../guide/tensors-and-tiles.md:173
msgid ""
"Matrix multiply accumulates repeated `mma` calls across the K dimension. "
"Each tile block owns one output tile. Each loop iteration loads a `[BM, BK]` "
"tile from the left input and a `[BK, BN]` tile from the right input."
msgstr ""

#: ../../../guide/tensors-and-tiles.md:175
msgid ""
"fn tiled_gemm<\n"
"    E: ElementType,\n"
"    const BM: i32,\n"
"    const BN: i32,\n"
"    const BK: i32,\n"
">(\n"
"    z: &mut Tensor<f32, { [BM, BN] }>,\n"
"    x: &Tensor<E, { [-1, -1] }>,\n"
"    y: &Tensor<E, { [-1, -1] }>,\n"
") {\n"
"    let pid_m = program_id(0);\n"
"    let pid_n = program_id(1);\n"
"    let k_tiles = x.shape()[1] / BK;\n"
"\n"
"    let part_x = x.partition(shape![BM, BK]);\n"
"    let part_y = y.partition(shape![BK, BN]);\n"
"\n"
"    let mut acc = constant(0.0f32, shape![BM, BN]);\n"
"    for k_tile in 0i32..k_tiles {\n"
"        let tile_x = part_x.load([pid_m, k_tile]);\n"
"        let tile_y = part_y.load([k_tile, pid_n]);\n"
"        acc = mma(tile_x, tile_y, acc);\n"
"    }\n"
"\n"
"    z.store(acc);\n"
"}\n"
msgstr ""

#: ../../../guide/tensors-and-tiles.md:204
msgid ""
"The output accumulator usually uses a wider type than the inputs. For "
"example, FP16 or FP8 inputs often accumulate into FP32."
msgstr ""

#: ../../../guide/tensors-and-tiles.md:206
msgid "Type Safety and Generics"
msgstr ""

#: ../../../guide/tensors-and-tiles.md:208
msgid ""
"The compiler catches shape mismatches, element-type mismatches, and invalid "
"matrix multiply shapes before code runs:"
msgstr ""

#: ../../../guide/tensors-and-tiles.md:210
msgid ""
"let a: Tile<f32, { [16, 8] }> = ...;\n"
"let b: Tile<f32, { [16, 32] }> = ...;\n"
"let c = mma(a, b, acc); // Error: inner dimensions do not match.\n"
msgstr ""

#: ../../../guide/tensors-and-tiles.md:216
msgid "Use explicit conversion when element types differ:"
msgstr ""

#: ../../../guide/tensors-and-tiles.md:218
msgid ""
"let y_float: Tile<f32, { [4, 4] }> = convert_tile(y_int);\n"
"let z = x_float + y_float;\n"
msgstr ""

#: ../../../guide/tensors-and-tiles.md:223
msgid "Generic kernels can support multiple shapes and element types:"
msgstr ""

#: ../../../guide/tensors-and-tiles.md:225
msgid ""
"#[cutile::entry()]\n"
"fn scale<E: ElementType, const S: [i32; 2]>(\n"
"    z: &mut Tensor<E, S>,\n"
"    x: &Tensor<E, { [-1, -1] }>,\n"
"    alpha: E,\n"
") {\n"
"    let tile = x.load_like(z);\n"
"    z.store(tile * alpha);\n"
"}\n"
msgstr ""

#: ../../../guide/tensors-and-tiles.md:237
msgid ""
"Each concrete element type and const generic value can produce a separate "
"compiled variant. Dynamic tensor dimensions do not."
msgstr ""

